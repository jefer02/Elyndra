<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Metadatos (ScreenScraper, IGDB, SteamGridDB, RetroAchievements) y Masha (DeepSeek). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Aplicar metadatos a toda la biblioteca" puede durar mucho: corre en un
         servicio en primer plano para que no se congele al salir de la app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Tiempo de juego exacto (opcional). No es un permiso que se pida en un
         diálogo: el usuario lo concede, si quiere, en Ajustes del sistema →
         Acceso de uso, desde Ajustes → Masha. Sin él, las sesiones se miden
         entre el lanzamiento y la vuelta a Elyndra. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Mandos. Elyndra se maneja entero con un mando (Xbox, PlayStation,
         Switch Pro, clónicos y los mandos integrados de las portátiles
         Android), pero no lo exige: `required="false"` para que siga
         instalándose en un móvil. Lo mismo con la pantalla táctil al revés —
         declararla opcional es lo que permite instalarla en una tele. -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Visibilidad de paquetes (Android 11+): Elyndra tiene que ver los juegos
         instalados y los emuladores a los que entrega cada ROM. No es un permiso
         que se pida al usuario, se declara aquí: sin esto el PackageManager
         contesta "no instalado" a todo.

         Los tres <intent> cubren cualquier app que se pueda abrir (móvil o TV) y
         las que declaran VIEW, que es como recibe la ROM la mayoría de emuladores. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>

        <!-- Runtimes de Windows (juegos de PC). Van uno a uno porque no se les
             llega por ningún intent genérico: el juego se lanza con una acción
             propia de cada paquete ("banner.hub.LAUNCH_GAME") o con su actividad
             explícita, y varios se publican como build "de reemplazo" bajo el
             paquete de otra app. La lista es la de Emulators.kt. -->
        <package android:name="com.winlator" />
        <package android:name="com.winlator.cmod" />
        <package android:name="com.winlator.vanilla" />
        <package android:name="com.cmodded.winlator" />
        <package android:name="com.winlator.banner" />
        <package android:name="com.winnative.cmod" />
        <package android:name="banner.hub" />
        <package android:name="gamehub.lite" />
        <package android:name="emuready.gamehub.lite" />
        <package android:name="app.gamenative" />
        <package android:name="com.mobox.launcher" />
        <package android:name="com.micewine.emu" />
        <package android:name="com.xiaoji.egggame" />
        <package android:name="com.antutu.ABenchMark" />
        <package android:name="com.antutu.benchmark.full" />
        <package android:name="com.ludashi.aibench" />
        <package android:name="com.ludashi.benchmark" />
        <package android:name="com.miHoYo.GenshinImpact" />
        <package android:name="com.tencent.ig" />
        <package android:name="com.tencent.tmgp.cf" />
    </queries>

    <!-- allowBackup desactivado: los permisos de carpeta (SAF) y la clave del
         Keystore que cifra las credenciales no sobreviven a una restauración. -->
    <application
        android:name=".ElyndraApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elyndra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Elyndra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- En una tele el lanzador de Android TV solo lista lo que
                     declara LEANBACK_LAUNCHER; sin esto, Elyndra se instala
                     pero no aparece por ningún lado. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".metadata.ScrapeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Expone una ROM concreta a un emulador concreto (equivalente al
             %ROMPROVIDER% de ES-DE). Solo lee, y solo la URI que se concede. -->
        <provider
            android:name=".launch.RomProvider"
            android:authorities="${applicationId}.roms"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Widget de Masha en la pantalla de inicio (Jetpack Glance). -->
        <receiver
            android:name=".widget.MashaWidgetReceiver"
            android:exported="true"
            android:label="@string/masha">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/masha_widget_info" />
        </receiver>

        <!-- WorkManager se inicia a demanda con la fábrica de Hilt
             (ElyndraApplication.workManagerConfiguration): se quita su
             inicializador automático, que usaría la fábrica por defecto. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
