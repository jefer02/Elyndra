<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Metadatos (ScreenScraper, IGDB, SteamGridDB, RetroAchievements) y Lucy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "Aplicar metadatos a toda la biblioteca" puede durar mucho: corre en un
         servicio en primer plano para que no se congele al salir de la app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Visibilidad de paquetes (Android 11+): Elyndra tiene que ver los juegos
         instalados y los emuladores a los que entrega cada ROM. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- allowBackup desactivado: los permisos de carpeta (SAF) y la clave del
         Keystore que cifra las credenciales no sobreviven a una restauración. -->
    <application
        android:name=".ElyndraApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elyndra">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Elyndra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".metadata.ScrapeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Expone una ROM concreta a un emulador concreto (equivalente al
             %ROMPROVIDER% de ES-DE). Solo lee, y solo la URI que se concede. -->
        <provider
            android:name=".launch.RomProvider"
            android:authorities="${applicationId}.roms"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
