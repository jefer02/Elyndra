<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo "papel" del diseño detrás de la ventana, para que no haya
         destello blanco/negro entre el arranque y el primer frame de Compose. -->
    <style name="Theme.Elyndra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
