<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Fondo "papel" del diseño detrás de la ventana, para que no haya
         destello blanco/negro entre el arranque y el primer frame de Compose. -->
    <style name="Theme.Elyndra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Splash oficial (API SplashScreen) sin icono: solo el fondo de la intro,
         del mismo color que su primer fotograma (BootIntro), así el paso de uno
         a otro no se ve. El tema claro u oscuro es una opción de la app: desde
         Android 13 MainActivity elige .Light o .Dark para el siguiente arranque;
         antes, manda el tema del sistema (values-night). -->
    <style name="Theme.Elyndra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/intro_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Elyndra</item>
    </style>

    <style name="Theme.Elyndra.Starting.Light">
        <item name="windowSplashScreenBackground">@color/intro_pearl</item>
    </style>

    <style name="Theme.Elyndra.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/intro_smoke</item>
    </style>
</resources>
